@page "/"
@rendermode InteractiveServer
@inject WebApp.Services.DatabaseService DbService
@inject WebApp.Services.KubernetesClusterInfoService ClusterInfo
@inject IConfiguration Configuration

<h1>SQL Server Connection Test</h1>

<p>
    <strong>Kubernetes API Server:</strong> @(apiServer?.GitVersion ?? "checking...") @(apiServer?.Platform is { } pl ? $"({pl})" : "")<br />
    @if (apiServer?.BuildDate is not null)
    {
        <text><strong>Build Date:</strong> @apiServer.BuildDate<br /></text>
    }
    @if (apiServer?.GoVersion is not null)
    {
        <text><strong>Go Version:</strong> @apiServer.GoVersion<br /></text>
    }
    <strong>Node:</strong> @(Configuration["NODE_NAME"] ?? "unknown")
</p>

@if (status is null)
{
    <p>Checking connection...</p>
}
else if (status == true)
{
    <p style="color: green;">Connected successfully.</p>
    <pre style="white-space: pre-wrap;">@serverVersion</pre>
    @if (sqlIdentity is not null)
    {
        <p>
            <strong>SQL Server Name:</strong> @sqlIdentity.ServerName<br />
            <strong>SQL Machine Name:</strong> @sqlIdentity.MachineName<br />
            <strong>SQL Instance ID (generated on first run):</strong> @sqlIdentity.InstanceId
        </p>
    }
}
else
{
    <p style="color: red;">Connection failed: @errorMessage</p>
}

<button @onclick="CheckConnection">Re-check connection</button>

@code {
    private bool? status;
    private string? serverVersion;
    private string? errorMessage;
    private ApiServerInfo? apiServer;
    private SqlServerIdentity? sqlIdentity;

    protected override async Task OnInitializedAsync()
    {
        apiServer = await ClusterInfo.GetApiServerVersionAsync();
        await CheckConnection();
    }

    private async Task CheckConnection()
    {
        status = null;
        StateHasChanged();
        try
        {
            serverVersion = await DbService.GetServerVersionAsync();
            sqlIdentity = await DbService.GetServerIdentityAsync();
            status = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            status = false;
        }
    }
}
